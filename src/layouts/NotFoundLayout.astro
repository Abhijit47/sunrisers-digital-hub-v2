---
import { ClientRouter } from 'astro:transitions';
---

<html
  lang='en'
  class='scroll-smooth'
  transition:name='root'
  transition:animate='none'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='icon' href='/favicon.ico' />
    <meta content='width=device-width, initial-scale=1.0' name='viewport' />
    <meta name='generator' content={Astro.generator} />
    <title>404 | Sunrisers Digital Hub</title>
    <meta
      name='description'
      content={
        'Grow your business with Sunrisers Digital Hub, a digital marketing agency in Bangalore offering SEO, Google Ads, social media marketing, website development and AI search visibility.'
      }
    />
    <meta property='og:title' content={'404 - Not Found'} />
    <meta
      property='og:description'
      content={
        'Grow your business with Sunrisers Digital Hub, a digital marketing agency in Bangalore offering SEO, Google Ads, social media marketing, website development and AI search visibility.'
      }
    />
    <meta
      property='og:image'
      content={'https://sunrisersdigitalhub.com/og-image.png'}
    />
    <meta property='og:url' content={'https://sunrisersdigitalhub.com'} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={'404 - Not Found'} />
    <meta
      name='twitter:description'
      content={
        'Grow your business with Sunrisers Digital Hub, a digital marketing agency in Bangalore offering SEO, Google Ads, social media marketing, website development and AI search visibility.'
      }
    />
    <meta
      name='twitter:image'
      content={'https://sunrisersdigitalhub.com/og-image.png'}
    />
    <meta name='twitter:site' content='@sunrisersdh' />
    <meta name='twitter:creator' content='@sunrisersdh' />
    <meta
      name='keywords'
      content='digital marketing agency in Bangalore Bangalore, digital marketing company in Bangalore, digital marketing services in Bangalore, SEO services in Bangalore, SEO agency in Bangalore, Google Ads management in Bangalore, social media marketing agency in Bangalore, website development company in Bangalore, website design company in Bangalore, lead generation services in Bangalore, AI search optimization, AEO and GEO'
    />
    <ClientRouter />
  </head>
  <body class='bg-foreground text-muted-foreground antialiased selection:bg-primary selection:text-primary-foreground'>
    <slot />
  </body>
</html>

<style is:global>
  @keyframes bump {
    0% {
      opacity: 0;
      transform: scale(1) translateX(200px);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateX(0);
    }
  }

  @keyframes pixelateOut {
    0% {
      filter: blur(0px);
      opacity: 1;
    }
    100% {
      filter: blur(40px);
      opacity: 0;
    }
  }

  @keyframes pixelateIn {
    0% {
      filter: blur(40px);
      opacity: 0;
    }
    100% {
      filter: blur(0px);
      opacity: 1;
    }
  }

  @keyframes wipeOut {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
    }
  }

  @keyframes wipeIn {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
