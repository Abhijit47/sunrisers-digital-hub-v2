---
import { RocketIcon } from 'lucide-react';
---

<!-- BEGIN: RocketCtaBanner -->
<section
  class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6'
  data-purpose='growth-cta-banner'>
  <div class='relative rocket-banner-gradient rounded-3xl p-8 sm:p-12 overflow-hidden shadow-xl text-white flex flex-col md:flex-row items-center justify-between'>
    <!-- Text side -->
    <div class='z-10 max-w-xl space-y-3 mb-6 md:mb-0'>
      <div class='inline-flex items-center gap-2 text-background font-bold text-xs tracking-widest uppercase'>
        <span class='w-5 h-0.5 bg-primary inline-block'></span>
        LET'S GROW TOGETHER
      </div>
      <h2 class='text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight'>
        Ready to Accelerate <br class='hidden sm:inline' />
        <span class='text-primary'>Your Business Growth?</span>
      </h2>
      <p class='text-muted-foreground text-xs sm:text-sm md:text-base font-normal'>
        Partner with Sunrisers Digital Hub and turn your digital goals into
        reality.
      </p>
    </div>
    <!-- Illustrated Rocket Blast Graphic -->
    <div class='relative w-64 h-36 flex items-center justify-center'>
      <!-- Trail SVG -->
      <svg
        class='absolute inset-0 w-full h-full'
        fill='none'
        viewBox='0 0 240 120'>
        <path
          d='M 10 110 C 70 100, 140 70, 190 30'
          stroke='#f97316'
          stroke-linecap='round'
          stroke-width='6'></path>
        <path
          d='M 10 110 C 70 100, 140 70, 190 30'
          stroke='#fde047'
          stroke-linecap='round'
          stroke-width='2'></path>
      </svg>
      <!-- Rocket Icon/Illustration -->
      <div class='absolute right-4 top-3 text-white transform rotate-45'>
        <div class='relative'>
          <!-- <i class='fa-solid fa-rocket text-5xl text-slate-100 drop-shadow-[0_4px_12px_rgba(249,115,22,0.8)]'></i> -->
          <RocketIcon className='size-10 text-background drop-shadow-[0_4px_12px_rgba(249,115,22,0.8)]' />
          <span class='absolute -bottom-2 -left-2 w-4 h-4 bg-orange-500 rounded-full blur-sm'></span>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: RocketCtaBanner -->
