---
import Link from 'astro-typesafe-routes/link';
import { Image } from 'astro:assets';
import { ArrowRightCircle } from 'lucide-react';
import Logo from '../../public/logo.png';
import {
  InputGroup,
  InputGroupAddon,
  InputGroupButton,
  InputGroupInput,
} from './ui/input-group';

const year = new Date().getFullYear();

const footerLinks = {
  quickLinks: [
    { name: 'Home', href: '/' },
    { name: 'About Us', href: '/about' },
    { name: 'Services', href: '/services' },
    { name: 'Case Studies', href: '/case-studies' },
    { name: 'Contact', href: '/contact' },
  ],
  ourServices: [
    { name: 'Performance Marketing', href: '/services/performance-marketing' },
    { name: 'Lead Generation', href: '/services/lead-generation' },
    {
      name: 'Social Media Management',
      href: '/services/social-media-management',
    },
    { name: 'Marketing Automation', href: '/services/marketing-automation' },
    { name: 'Growth Consulting', href: '/services/growth-consulting' },
  ],
  industries: [
    { name: 'Real Estate', href: '/industries/real-estate' },
    { name: 'Healthcare', href: '/industries/healthcare' },
    { name: 'Education', href: '/industries/education' },
    { name: 'D2C Brands', href: '/industries/d2c-brands' },
    { name: 'Travel & Tourism', href: '/industries/travel-tourism' },
    { name: 'Restaurants', href: '/industries/restaurants' },
  ],
};
---

<!-- BEGIN: MainFooter -->
<footer
  class='bg-foreground dark:bg-background text-muted-foreground pt-16 pb-8 border-t border-border'
  data-purpose='site-footer'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Top Grid of Footer Links -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-14 border-b border-slate-800'>
      <!-- Brand Info -->
      <div class='lg:col-span-4'>
        <Link class='flex items-center gap-2 mb-4' to='/'>
          <Image
            src={Logo}
            alt='Sunrisers Digital Hub Logo'
            inferSize={true}
            class={'w-auto h-12'}
          />
        </Link>
        <p class='text-xs text-slate-400 mb-6 font-medium'>
          Strategy. Marketing. Automation. Growth.
        </p>
        <div class='flex items-center gap-3 text-slate-300'>
          <a
            aria-label='LinkedIn'
            class='w-8 h-8 rounded-full bg-slate-800/80 hover:bg-brand-orange hover:text-white flex items-center justify-center transition-colors text-xs'
            href='#'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='24'
              height='24'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin'>
              <path stroke='none' d='M0 0h24v24H0z' fill='none' />
              <path d='M8 11v5' />
              <path d='M8 8v.01' />
              <path d='M12 16v-5' />
              <path d='M16 16v-3a2 2 0 1 0 -4 0' />
              <path d='M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10' />
            </svg>
          </a>
          <a
            aria-label='Instagram'
            class='w-8 h-8 rounded-full bg-slate-800/80 hover:bg-brand-orange hover:text-white flex items-center justify-center transition-colors text-xs'
            href='#'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='24'
              height='24'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram'>
              <path stroke='none' d='M0 0h24v24H0z' fill='none' />
              <path d='M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10' />
              <path d='M8.5 12a3.5 3.5 0 1 0 7 0a3.5 3.5 0 0 0 -7 0' />
              <path d='M17 7v.01' />
            </svg>
          </a>
          <a
            aria-label='YouTube'
            class='w-8 h-8 rounded-full bg-slate-800/80 hover:bg-brand-orange hover:text-white flex items-center justify-center transition-colors text-xs'
            href='#'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='24'
              height='24'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='icon icon-tabler icons-tabler-outline icon-tabler-brand-youtube'>
              <path stroke='none' d='M0 0h24v24H0z' fill='none' />
              <path d='M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8' />
              <path d='M10 9l5 3l-5 3l0 -6' />
            </svg>
          </a>
          <a
            aria-label='Facebook'
            class='w-8 h-8 rounded-full bg-slate-800/80 hover:bg-brand-orange hover:text-white flex items-center justify-center transition-colors text-xs'
            href='#'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='24'
              height='24'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook'>
              <path stroke='none' d='M0 0h24v24H0z' fill='none' />
              <path d='M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3' />
            </svg>
          </a>
        </div>
      </div>
      <!-- Quick Links -->
      <div class='lg:col-span-2 space-y-4'>
        <h4 class='text-xs uppercase tracking-wider font-extrabold text-background'>
          Quick Links
        </h4>
        <ul class='space-y-2.5 text-xs'>
          {footerLinks.quickLinks.map((link) => (
            <li>
              <a
                class='hover:text-primary transition-colors block'
                href={link.href}>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Our Services -->
      <div class='lg:col-span-2 space-y-4'>
        <h4 class='text-xs uppercase tracking-wider font-extrabold text-background'>
          Our Services
        </h4>
        <ul class='space-y-2.5 text-xs'>
          {footerLinks.ourServices.map((link) => (
            <li>
              <a
                class='hover:text-primary transition-colors block'
                href={link.href}>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Industries -->
      <div class='lg:col-span-2 space-y-4'>
        <h4 class='text-xs uppercase tracking-wider font-extrabold text-background'>
          Industries
        </h4>
        <ul class='space-y-2.5 text-xs'>
          {footerLinks.industries.map((link) => (
            <li>
              <a
                class='hover:text-primary transition-colors block'
                href={link.href}>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Stay Updated -->
      <div class='lg:col-span-2'>
        <h4 class='text-xs uppercase tracking-wider font-extrabold text-white mb-4'>
          Stay Updated
        </h4>
        <p class='text-xs text-slate-400 mb-3 leading-relaxed'>
          Get actionable marketing insights and growth tips.
        </p>
        <form class='flex items-center' onsubmit='event.preventDefault()'>
          <InputGroup>
            <InputGroupInput placeholder='Type to search...' />
            <InputGroupAddon align='inline-end' className='-mr-2.5!'>
              <InputGroupButton
                variant='secondary'
                size={'icon-sm'}
                type='submit'>
                <ArrowRightCircle />
              </InputGroupButton>
            </InputGroupAddon>
          </InputGroup>
        </form>
      </div>
    </div>
    <!-- Bottom Copyright & Legal Links -->
    <div class='pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-3'>
      <p>© {year} Sunrisers Digital Hub. All Rights Reserved.</p>
      <div class='flex items-center gap-4'>
        <a class='hover:text-slate-200 transition-colors' href='#'>
          Privacy Policy
        </a>
        <span>|</span>
        <a class='hover:text-slate-200 transition-colors' href='#'>
          Terms &amp; Conditions
        </a>
      </div>
    </div>
  </div>
</footer>
<!-- END: MainFooter -->
