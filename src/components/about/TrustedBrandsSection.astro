<!-- BEGIN: TrustedBrandsSection -->
<section class='py-12 bg-white' data-purpose='trusted-brands'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <div class='flex flex-col lg:flex-row items-center gap-8 justify-between'>
      <!-- Header -->
      <div class='lg:w-1/3 shrink-0'>
        <div class='inline-flex items-center gap-2 text-brand-orange font-bold text-[11px] tracking-widest uppercase'>
          <span class='w-5 h-0.5 bg-brand-orange inline-block'></span>
          TRUSTED BY LEADING BRANDS
        </div>
        <h3 class='text-xl font-extrabold text-[#08234d] tracking-tight mt-1'>
          Brands That Believe in Us
        </h3>
      </div>
      <div class='hidden lg:block w-px h-12 bg-slate-200'></div>
      <!-- Partner Brand Logos Row -->
      <div class='w-full lg:w-2/3 flex flex-wrap items-center justify-between gap-6 sm:gap-8 text-slate-600'>
        <!-- TATA -->
        <div class='flex items-center gap-1.5 font-bold tracking-tight text-xl text-slate-800'>
          <span class='w-6 h-6 rounded-full bg-blue-700 text-white flex items-center justify-center text-[10px] font-black'>
            T
          </span>
          <span>TATA</span>
        </div>
        <div class='h-6 w-px bg-slate-200 hidden sm:block'></div>
        <!-- BOSCH -->
        <div class='flex items-center gap-2 font-black tracking-wider text-xl text-slate-800'>
          <i class='fa-solid fa-circle-nodes text-red-600 text-base'></i>
          <span>BOSCH</span>
        </div>
        <div class='h-6 w-px bg-slate-200 hidden sm:block'></div>
        <!-- Godrej -->
        <div class='font-serif italic font-extrabold text-2xl text-rose-600 tracking-tight'>
          Godrej
        </div>
        <div class='h-6 w-px bg-slate-200 hidden sm:block'></div>
        <!-- Infosys -->
        <div class='font-bold text-xl text-blue-600 tracking-tight'>
          Infosys<sup class='text-[9px]'>®</sup>
        </div>
        <div class='h-6 w-px bg-slate-200 hidden sm:block'></div>
        <!-- BYJU'S -->
        <div class='bg-[#813588] text-white px-2.5 py-0.5 rounded font-black text-sm tracking-wide'>
          B BYJU'S
        </div>
        <div class='h-6 w-px bg-slate-200 hidden sm:block'></div>
        <!-- HDFC BANK -->
        <div class='flex items-center gap-1.5'>
          <div class='w-4 h-4 bg-red-600 border border-blue-900'></div>
          <span class='font-black text-sm text-[#004c8f] tracking-tight'>
            HDFC BANK
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: TrustedBrandsSection -->
