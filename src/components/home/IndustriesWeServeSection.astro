---

<!-- BEGIN: IndustriesWeServeSection -->
<section
  class='py-16 bg-slate-50 border-t border-slate-100'
  data-purpose='industries-badges'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Heading -->
    <div class='text-center mb-10'>
      <div class='inline-flex items-center gap-2 mb-2'>
        <span class='w-4 h-1 bg-brand-orange rounded-full'></span>
        <span class='text-xs uppercase tracking-wider font-extrabold text-brand-orange'>
          INDUSTRIES WE SERVE
        </span>
        <span class='w-4 h-1 bg-brand-orange rounded-full'></span>
      </div>
      <h2 class='text-2xl sm:text-3xl font-extrabold text-slate-900'>
        Digital Solutions for Diverse Businesses
      </h2>
    </div>
    <!-- Industry Cards / Pills Grid -->
    <div class='grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4'>
      <!-- Real Estate -->
      <div class='bg-white rounded-xl p-4 text-center border border-slate-200/90 shadow-sm hover:border-brand-orange hover:shadow-md transition-all group cursor-pointer flex flex-col items-center justify-center'>
        <div class='text-blue-600 mb-2 group-hover:scale-110 transition-transform'>
          <i class='fa-solid fa-city text-xl'></i>
        </div>
        <span class='text-xs sm:text-sm font-bold text-slate-800'>
          Real Estate
        </span>
      </div>
      <!-- Healthcare -->
      <div class='bg-white rounded-xl p-4 text-center border border-slate-200/90 shadow-sm hover:border-brand-orange hover:shadow-md transition-all group cursor-pointer flex flex-col items-center justify-center'>
        <div class='text-blue-600 mb-2 group-hover:scale-110 transition-transform'>
          <i class='fa-solid fa-heart-pulse text-xl'></i>
        </div>
        <span class='text-xs sm:text-sm font-bold text-slate-800'>
          Healthcare
        </span>
      </div>
      <!-- Education -->
      <div class='bg-white rounded-xl p-4 text-center border border-slate-200/90 shadow-sm hover:border-brand-orange hover:shadow-md transition-all group cursor-pointer flex flex-col items-center justify-center'>
        <div class='text-blue-600 mb-2 group-hover:scale-110 transition-transform'>
          <i class='fa-solid fa-graduation-cap text-xl'></i>
        </div>
        <span class='text-xs sm:text-sm font-bold text-slate-800'>
          Education
        </span>
      </div>
      <!-- D2C Brands -->
      <div class='bg-white rounded-xl p-4 text-center border border-slate-200/90 shadow-sm hover:border-brand-orange hover:shadow-md transition-all group cursor-pointer flex flex-col items-center justify-center'>
        <div class='text-blue-600 mb-2 group-hover:scale-110 transition-transform'>
          <i class='fa-solid fa-bag-shopping text-xl'></i>
        </div>
        <span class='text-xs sm:text-sm font-bold text-slate-800'>
          D2C Brands
        </span>
      </div>
      <!-- Travel & Tourism -->
      <div class='bg-white rounded-xl p-4 text-center border border-slate-200/90 shadow-sm hover:border-brand-orange hover:shadow-md transition-all group cursor-pointer flex flex-col items-center justify-center'>
        <div class='text-blue-600 mb-2 group-hover:scale-110 transition-transform'>
          <i class='fa-solid fa-plane-departure text-xl'></i>
        </div>
        <span class='text-xs sm:text-sm font-bold text-slate-800'>
          Travel &amp; Tourism
        </span>
      </div>
      <!-- Restaurants -->
      <div class='bg-white rounded-xl p-4 text-center border border-slate-200/90 shadow-sm hover:border-brand-orange hover:shadow-md transition-all group cursor-pointer flex flex-col items-center justify-center'>
        <div class='text-blue-600 mb-2 group-hover:scale-110 transition-transform'>
          <i class='fa-solid fa-utensils text-xl'></i>
        </div>
        <span class='text-xs sm:text-sm font-bold text-slate-800'>
          Restaurants
        </span>
      </div>
    </div>
  </div>
</section>
<!-- END: IndustriesWeServeSection -->
