---

<!-- BEGIN: ClientTestimonialsSection -->
<section
  class='py-20 bg-slate-50 border-b border-slate-200'
  data-purpose='client-testimonials'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Section Title & Arrows -->
    <div class='flex items-end justify-between mb-12'>
      <div>
        <div class='flex items-center gap-2 mb-2'>
          <span class='w-5 h-1 bg-brand-orange rounded-full'></span>
          <span class='text-xs uppercase tracking-wider font-extrabold text-brand-orange'>
            CLIENT TESTIMONIALS
          </span>
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight'>
          What Our Clients Say
        </h2>
      </div>
      <!-- Slider Arrow Controls -->
      <div class='flex items-center gap-2.5'>
        <button
          aria-label='Previous Testimonial'
          class='w-9 h-9 rounded-full border border-slate-300 hover:border-brand-orange hover:text-brand-orange flex items-center justify-center text-slate-600 transition-colors'
          type='button'>
          <i class='fa-solid fa-chevron-left text-xs'></i>
        </button>
        <button
          aria-label='Next Testimonial'
          class='w-9 h-9 rounded-full border border-slate-300 hover:border-brand-orange hover:text-brand-orange flex items-center justify-center text-slate-600 transition-colors'
          type='button'>
          <i class='fa-solid fa-chevron-right text-xs'></i>
        </button>
      </div>
    </div>
    <!-- Testimonial Cards 3-Grid -->
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8'>
      <!-- Review 1 -->
      <div class='bg-white rounded-2xl p-7 border border-slate-200/90 shadow-sm flex flex-col justify-between'>
        <div>
          <div class='text-brand-orange text-3xl font-serif leading-none mb-3'>
            “
          </div>
          <p class='text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-medium'>
            Sunrisers Digital Hub helped us generate a consistent flow of
            qualified leads. Their strategy, execution, and reporting are
            top-notch.
          </p>
        </div>
        <div class='pt-4 border-t border-slate-100 flex items-center gap-3.5'>
          <div class='w-11 h-11 rounded-full bg-slate-200 overflow-hidden shrink-0'>
            <img
              alt='Rahul Sharma'
              class='w-full h-full object-cover'
              src='https://lh3.googleusercontent.com/aida-public/AB6AXuCh7fn7QHihsfESKNg7hQrK1SNqdwouW4NXkKpb51RJPao0W_kWyrcdOOPY5QD6EfErMQbg6uM_r8UrkZX06uizZNTfu-Vi02fCGCfWBsqoImMVeZD9aebJi-79BHBj0MmSH44kmK85lpW5XmlBohV86mP7WnjW6mHA-jpXb4ceDIlvbdxRLOoxt5pfr8ENF7wlZKTxm8ukvIc0CKIbvWfg8V2azewbz-2yPACjzp2a'
            />
          </div>
          <div>
            <div class='flex text-amber-400 text-xs mb-1'>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
            </div>
            <h4 class='text-sm font-bold text-slate-900 leading-tight'>
              Rahul Sharma
            </h4>
            <p class='text-[11px] text-slate-400 font-medium'>
              Real Estate Developer
            </p>
          </div>
        </div>
      </div>
      <!-- Review 2 -->
      <div class='bg-white rounded-2xl p-7 border border-slate-200/90 shadow-sm flex flex-col justify-between'>
        <div>
          <div class='text-brand-orange text-3xl font-serif leading-none mb-3'>
            “
          </div>
          <p class='text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-medium'>
            The team is highly professional and result-oriented. Our online
            bookings increased significantly within 3 months.
          </p>
        </div>
        <div class='pt-4 border-t border-slate-100 flex items-center gap-3.5'>
          <div class='w-11 h-11 rounded-full bg-slate-200 overflow-hidden shrink-0'>
            <img
              alt='Priya Nair'
              class='w-full h-full object-cover'
              src='https://lh3.googleusercontent.com/aida-public/AB6AXuDzljLuFOHAx4y-OeodAHbF5Vp-JR4eFUSKhyDydfNrdl6dH4WZyjW8bhEGqUAhbscGXtyeucOE6KwdbEGX9U6QmzOg8naPiQgQsCxaH7cjKCrP-o23KE5zNF3gLltCTXvz7QnjE5NdNGMd50ROcH6bkz8Eo6o-k2ppaCMpFHWDKWU1nEIqE8wLrJ6u5REjnYkhqfVU-uGQVvk5UfnD7Pa3exzq7Lr55BUinrLHwdUx'
            />
          </div>
          <div>
            <div class='flex text-amber-400 text-xs mb-1'>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
            </div>
            <h4 class='text-sm font-bold text-slate-900 leading-tight'>
              Priya Nair
            </h4>
            <p class='text-[11px] text-slate-400 font-medium'>Wellness Coach</p>
          </div>
        </div>
      </div>
      <!-- Review 3 -->
      <div class='bg-white rounded-2xl p-7 border border-slate-200/90 shadow-sm flex flex-col justify-between'>
        <div>
          <div class='text-brand-orange text-3xl font-serif leading-none mb-3'>
            “
          </div>
          <p class='text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-medium'>
            Great expertise in performance marketing and automation. They
            understand business goals and deliver measurable results.
          </p>
        </div>
        <div class='pt-4 border-t border-slate-100 flex items-center gap-3.5'>
          <div class='w-11 h-11 rounded-full bg-slate-200 overflow-hidden shrink-0'>
            <img
              alt='Amit Verma'
              class='w-full h-full object-cover'
              src='https://lh3.googleusercontent.com/aida-public/AB6AXuC8rRQULIAe95oVrvi_UNGRmGaaLA62ikj1TCC2WT5LvSlE4G3wkIgy33g5SUmOnw5S9uwZszh6pVGs_KfEElVoilE1IygmI8GFe4xcaNlP8QmKIoQcPhADgJpvmUpWlTLmlESGGERwr5m8ryTzEYaBoaKl6rniMpXrT_MpE3JLihq-cYnfRXYErNCO0fYzEsXJHPKX9Ng7xUWBkXiqHKiN40gnY2HzsZ1OqcOrfOKR'
            />
          </div>
          <div>
            <div class='flex text-amber-400 text-xs mb-1'>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
              <i class='fa-solid fa-star'></i>
            </div>
            <h4 class='text-sm font-bold text-slate-900 leading-tight'>
              Amit Verma
            </h4>
            <p class='text-[11px] text-slate-400 font-medium'>
              D2C Brand Founder
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: ClientTestimonialsSection -->
