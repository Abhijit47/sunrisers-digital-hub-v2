---
import { wipeTransition } from '@/lib/view-transitions';
import Layout from '../layouts/Layout.astro';

import { createRoute } from 'astro-typesafe-routes/create-route';

export const Route = createRoute({
  routeId: '/about',
});

const pathname = Astro.request.url.split('/')[3] || '/';
---

<Layout title='About'>
  <main class='max-w-7xl mx-auto' transition:animate={wipeTransition}>
    <h1>{pathname}</h1>
  </main>
</Layout>
