---
import AboutUsSection from '@/components/home/AboutUsSection.astro';
import BrandsWorkedWithSection from '@/components/home/BrandsWorkedWithSection.astro';
import CaseStudiesSection from '@/components/home/CaseStudiesSection.astro';
import ClientTestimonialsSection from '@/components/home/ClientTestimonialsSection.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import IndustriesWeServeSection from '@/components/home/IndustriesWeServeSection.astro';
import OurServicesSection from '@/components/home/OurServicesSection.astro';
import PreFooterBannerCTA from '@/components/home/PreFooterBannerCTA.astro';
import WhyChooseUsSection from '@/components/home/WhyChooseUsSection.astro';
import Layout from '@/layouts/Layout.astro';
import { createRoute } from 'astro-typesafe-routes/create-route';
import { pixeletedTransition } from '../lib/view-transitions';

export const Route = createRoute({
  routeId: '/',
});
---

<Layout title='Home'>
  <main transition:animate={pixeletedTransition}>
    <HeroSection />
    <OurServicesSection />
    <AboutUsSection />
    <WhyChooseUsSection />
    <IndustriesWeServeSection />
    <CaseStudiesSection />
    <BrandsWorkedWithSection />
    <ClientTestimonialsSection />
    <PreFooterBannerCTA />
  </main>
</Layout>
