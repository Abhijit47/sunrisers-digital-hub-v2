                  {testimonial.designation}
                </p>
              </div>
            </div>
          </CardFooter>
        </Card>
      ))}
    </div> -->
  </div>
</section>
<!-- END: ClientTestimonialsSection -->

<script>
  import { getSwiperFromUniqueSelector } from 'astro-swiper';

  function initSwiper() {
    const swiper = getSwiperFromUniqueSelector('#swiper-custom-navigation');
    if (!swiper) return;

    // If you want to do something with the swiper instance, you can do it here
    // console.log('Swiper initialized:', swiper);

    const prevButton = document.querySelector<HTMLButtonElement>(
      '#client-success-stories-prev',
    );
    const nextButton = document.querySelector<HTMLButtonElement>(
      '#client-success-stories-next',
    );

    if (!swiper || !prevButton || !nextButton) return;

    if (
      !swiper.params.navigation ||
      typeof swiper.params.navigation === 'boolean'
    )
      return;

    swiper.params.navigation.prevEl = prevButton;
    swiper.params.navigation.nextEl = nextButton;
    swiper.init();
  }

  document.addEventListener('astro:page-load', initSwiper);
</script>
