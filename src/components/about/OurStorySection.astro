---
import Link from 'astro-typesafe-routes/link';
import {
  ArrowRightCircleIcon,
  ChartAreaIcon,
  ChartLineIcon,
  HandshakeIcon,
  RocketIcon,
  TargetIcon,
  UserIcon,
} from 'lucide-react';
import { buttonVariants } from '../ui/button';
---

<!-- BEGIN: OurStorySection -->
<section class='py-20' data-purpose='our-story'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-12 items-center'>
      <!-- Story Text Description -->
      <div class='lg:col-span-4 space-y-5'>
        <div class='inline-flex items-center gap-2 text-primary font-bold text-xs tracking-widest uppercase'>
          <span class='w-6 h-0.5 bg-primary inline-block'></span>
          OUR STORY
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold text-primary tracking-tight leading-tight'>
          From a Vision <br class='hidden sm:inline' />
          to a Growth Partner
        </h2>
        <p class='text-muted-foreground text-md leading-relaxed'>
          Sunrisers Digital Hub was born with a simple mission — to empower
          businesses with innovative digital marketing strategies that drive
          real results. Over the years, we've partnered with 500+ businesses,
          helping them achieve measurable growth and a stronger online presence.
        </p>
        <div class='pt-2'>
          <Link
            class={buttonVariants({
              variant: 'secondary',
              size: 'lg',
              className: 'rounded-full!',
            })}
            to='/about'>
            <span>Our Journey</span>
            <ArrowRightCircleIcon />
          </Link>
        </div>
      </div>
      <!-- Center 3D Digital Growth Graphic / Workspace -->
      <div class='lg:col-span-5 relative flex items-center justify-center'>
        <div class='relative w-full max-w-sm sm:max-w-md bg-linear-to-br from-blue-50 to-indigo-50/40 p-6 rounded-3xl border border-blue-100/80 shadow-lg shadow-blue-500/5'>
          <!-- Laptop Frame Graphic with Charts -->
          <div class='relative mx-auto bg-slate-800 rounded-t-xl p-2.5 pb-0 shadow-2xl border-2 border-slate-700'>
            <div class='bg-[#0b1a30] rounded-t-md p-3 relative overflow-hidden flex flex-col items-center justify-end h-44'>
              <!-- 3D Bar Graph Simulation -->
              <div class='flex items-end gap-2.5 z-10 w-full justify-center px-4 mb-2'>
                <div class='w-5 bg-sky-500 rounded-t h-12'></div>
                <div class='w-5 bg-sky-400 rounded-t h-20'></div>
                <div class='w-5 bg-blue-600 rounded-t h-16'></div>
                <div class='w-5 bg-amber-500 rounded-t h-28'></div>
                <div class='w-5 bg-brand-orange rounded-t h-32'></div>
              </div>
              <!-- Upward Rising Curved Arrow SVG -->
              <svg
                class='absolute inset-0 w-full h-full pointer-events-none'
                viewBox='0 0 200 150'>
                <path
                  d='M 30 110 Q 90 90, 160 30'
                  fill='transparent'
                  stroke='#f97316'
                  stroke-linecap='round'
                  stroke-width='4'></path>
                <polygon fill='#f97316' points='155,24 168,28 163,40'></polygon>
              </svg>
              <div class='absolute -bottom-8 -left-8 w-28 h-28 bg-blue-500/20 rounded-full blur-xl'></div>
            </div>
          </div>
          <!-- Laptop Base -->
          <div class='bg-slate-300 h-2.5 rounded-b-lg shadow-md max-w-[94%] mx-auto'></div>
          <div class='bg-slate-400 h-1 rounded-b max-w-[20%] mx-auto'></div>
          <!-- Floating Badge Chips -->
          <div class='absolute -top-3 -left-3 bg-white p-2.5 rounded-xl shadow-md border border-slate-100 flex items-center justify-center text-sky-500'>
            <UserIcon className='size-4' />
          </div>
          <div class='absolute top-1/2 -left-4 bg-white p-2.5 rounded-xl shadow-md border border-slate-100 flex items-center justify-center text-sky-600'>
            <ChartAreaIcon className='size-4' />
          </div>
          <div class='absolute -bottom-3 -right-3 bg-white p-2.5 rounded-xl shadow-md border border-slate-100 flex items-center justify-center text-sky-500'>
            <TargetIcon className='size-4' />
          </div>
        </div>
      </div>
      <!-- Right Value Badges Column -->
      <div class='lg:col-span-3 space-y-4'>
        <!-- Badge 1 -->
        <div class='bg-white p-4 rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex items-start gap-4'>
          <div class='w-10 h-10 rounded-xl bg-blue-50 shrink-0 flex items-center justify-center text-sky-500'>
            <RocketIcon className='size-4' />
          </div>
          <div>
            <h3 class='font-bold text-sm text-[#08234d]'>Innovation First</h3>
            <p class='text-xs text-slate-500 leading-snug mt-0.5'>
              Cutting-edge strategies for sustainable growth.
            </p>
          </div>
        </div>
        <!-- Badge 2 -->
        <div class='bg-white p-4 rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex items-start gap-4'>
          <div class='w-10 h-10 rounded-xl bg-blue-50 shrink-0 flex items-center justify-center text-sky-500'>
            <ChartLineIcon className='size-4' />
          </div>
          <div>
            <h3 class='font-bold text-sm text-[#08234d]'>Results Driven</h3>
            <p class='text-xs text-slate-500 leading-snug mt-0.5'>
              Data-backed solutions that deliver impact.
            </p>
          </div>
        </div>
        <!-- Badge 3 -->
        <div class='bg-white p-4 rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex items-start gap-4'>
          <div class='w-10 h-10 rounded-xl bg-blue-50 shrink-0 flex items-center justify-center text-sky-500'>
            <HandshakeIcon className='size-4' />
          </div>
          <div>
            <h3 class='font-bold text-sm text-[#08234d]'>Partner Focused</h3>
            <p class='text-xs text-slate-500 leading-snug mt-0.5'>
              Your success is our priority.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: OurStorySection -->
