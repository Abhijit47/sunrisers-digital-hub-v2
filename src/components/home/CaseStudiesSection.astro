---
import { cn } from '@/lib/utils';
import { ArrowRightCircleIcon } from 'lucide-react';
import { Button, buttonVariants } from '../ui/button';
---

<!-- BEGIN: CaseStudiesSection -->
<section
  class='py-20 bg-brand-navy text-primary'
  data-purpose='case-studies'
  id='work'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Header row -->
    <div class='flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12'>
      <div>
        <div class='flex items-center gap-2 mb-2'>
          <span class='w-5 h-1 bg-primary rounded-full'></span>
          <span class='text-xs uppercase tracking-wider font-extrabold text-muted-foreground'>
            CASE STUDIES
          </span>
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold text-accent tracking-tight'>
          Real Business Results
        </h2>
      </div>
      <a
        class={cn(
          buttonVariants({
            variant: 'outline',
            size: 'lg',
            class: 'rounded-full',
          }),
        )}
        href='#case-studies'>
        <span>View All Case Studies</span>
        <ArrowRightCircleIcon />
      </a>
    </div>
    <!-- 3 Case Study Cards Grid -->
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8'>
      <!-- Case Study 1: Real Estate -->
      <div class='bg-background rounded-2xl overflow-hidden shadow-2xl flex flex-col text-slate-900 group'>
        <div class='h-52 w-full overflow-hidden relative'>
          <img
            alt='Real Estate Case Study High Rise'
            class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-500'
            src='https://lh3.googleusercontent.com/aida/ALJJyrDk88ISxXmMn6FY1ooMt504Ys8WTvLqWADiKSn9IXrSrHKDd2mhFMmyCcWDEZN3sMO2Fa9H1T1KgylBtGI0fAYQJ78xf9TqmkyHerSPrzJhM9AcxXSbQ4hKB4GrPIa83opK4PRC2IMyNrnlKZVM2ITI_zCQOdLb2AQwce7d1G0MHYZVPtdqh0iHF6ndzD5ffLE6jp8UAx0x_7Jl0jx_AfksXAuodhU7pcU7l7AyGbGutw'
          />
        </div>
        <div class='p-6 flex-1 flex flex-col justify-between bg-white'>
          <div>
            <span class='inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[11px] font-bold tracking-wide mb-3'>
              Real Estate
            </span>
            <h3 class='text-xl font-black text-slate-900 mb-2'>
              50+ Leads in 20 Days
            </h3>
            <p class='text-xs sm:text-sm text-slate-500 leading-relaxed mb-6'>
              Generated high-quality leads with just ₹5,000 ad spend (CPL ₹84).
            </p>
          </div>
          <div class='flex justify-end pt-2 border-t border-slate-100'>
            <!-- <span class='w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center transform group-hover:translate-x-1 transition-transform'>
              <i class='fa-solid fa-arrow-right text-xs'></i>
            </span> -->
            <Button className='rounded-full!' size={'icon-lg'}>
              <ArrowRightCircleIcon />
            </Button>
          </div>
        </div>
      </div>
      <!-- Case Study 2: Wellness & Coaching -->
      <div class='bg-white rounded-2xl overflow-hidden shadow-2xl flex flex-col text-slate-900 group'>
        <div class='h-52 w-full overflow-hidden relative'>
          <img
            alt='Wellness and Yoga Case Study'
            class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-500'
            src='https://lh3.googleusercontent.com/aida/ALJJyrAiz7UTUUN8awHPwqA3UqIfgdOImgvbGcDFxxVEZRRed9ts_MrTxc7oTn9NRd9ToxOE7XESbD8PpG6QrC2JtiIEEeDPfMO_W8Hw0HOklHKh-lwC8XUItoOO3LUj-1a_FoNXRr6PKdjxgxhPE9HqLeC2juieGjiZI9yOmNFU0LYCx-2Yc8i5XkMqvXruYAQpxJcS6lN2fJH-07SI61_rbbISbuM62CqlQz5a8isjdAdm'
          />
        </div>
        <div class='p-6 flex-1 flex flex-col justify-between bg-white'>
          <div>
            <span class='inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[11px] font-bold tracking-wide mb-3'>
              Wellness &amp; Coaching
            </span>
            <h3 class='text-xl font-black text-slate-900 mb-2'>
              900+ Leads in 9 Months
            </h3>
            <p class='text-xs sm:text-sm text-slate-500 leading-relaxed mb-6'>
              Built a consistent lead pipeline with Meta Ads &amp; funnels.
            </p>
          </div>
          <div class='flex justify-end pt-2 border-t border-slate-100'>
            <Button className='rounded-full!' size={'icon-lg'}>
              <ArrowRightCircleIcon />
            </Button>
          </div>
        </div>
      </div>
      <!-- Case Study 3: D2C Brand -->
      <div class='bg-white rounded-2xl overflow-hidden shadow-2xl flex flex-col text-slate-900 group'>
        <div class='h-52 w-full overflow-hidden relative'>
          <img
            alt='D2C Retail Shopping Bags Case Study'
            class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-500'
            src='https://lh3.googleusercontent.com/aida/ALJJyrC6VsY8wydEmLF7unUR99Fhr4XyYbN5WRBmV6BXfIyX8rVw2GmyecjY9exwl1C3YWAm2Dz1mCtBzd5SeVuDKCs28ZKrSHMu1QurWZyXMkbJuyM-n6F6oIOAzFnUG4Jdc1OWWmyRqpEImGampej8XEK3fOTAc3rwn1vX2Dz-nKnaVmmuObMLW0g0g995vsWNXdIOYQ6U37zqnBLgU-lE5nt-gtmwEXQplGoqcPPUh0a0'
          />
        </div>
        <div class='p-6 flex-1 flex flex-col justify-between bg-white'>
          <div>
            <span class='inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[11px] font-bold tracking-wide mb-3'>
              D2C Brand
            </span>
            <h3 class='text-xl font-black text-slate-900 mb-2'>3.2x ROAS</h3>
            <p class='text-xs sm:text-sm text-slate-500 leading-relaxed mb-6'>
              Scaled revenue with performance marketing &amp; creative testing.
            </p>
          </div>
          <div class='flex justify-end pt-2 border-t border-slate-100'>
            <Button className='rounded-full!' size={'icon-lg'}>
              <ArrowRightCircleIcon />
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: CaseStudiesSection -->
