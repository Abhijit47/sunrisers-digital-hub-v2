---
import type { AstroSwiperOptions } from 'astro-swiper';
import { Swiper, SwiperSlide, SwiperWrapper } from 'astro-swiper';
import {
  ChevronLeftIcon,
  ChevronRightIcon,
  QuoteIcon,
  StarIcon,
} from 'lucide-react';
import { Button } from '../ui/button';
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '../ui/card';

const testimonies = [
  {
    name: 'Rahul Sharma',
    designation: 'Real Estate Developer',
    image: '/test-1.jpg',
    rating: 5,
    review:
      'Sunrisers Digital Hub helped us generate a consistent flow of qualified leads. Their strategy, execution, and reporting are top-notch.',
  },
  {
    name: 'Priya Nair',
    designation: 'Wellness Coach',
    image: '/test-2.jpg',
    rating: 5,
    review:
      'The team is highly professional and result-oriented. Our online bookings increased significantly within 3 months.',
  },
  {
    name: 'Amit Verma',
    designation: 'D2C Brand Founder',
    image: '/test-3.jpg',
    rating: 5,
    review:
      'Great expertise in performance marketing and automation. They understand business goals and deliver measurable results.',
  },
];

const repeatedTestimonials = Array.from(
  { length: 6 },
  () => testimonies,
).flat();

const isDev = import.meta.env.DEV;

const opts: AstroSwiperOptions = {
  // check options at https://swiperjs.com/swiper-api
  autoplay: {
    delay: 5000,
    disableOnInteraction: false,
    enabled: !isDev,
  },
  loop: true,
  rewind: true,
  grabCursor: true,
  slidesPerView: 3,
  spaceBetween: 20,
  breakpoints: {
    320: {
      slidesPerView: 1,
      spaceBetween: 20,
    },
    640: {
      slidesPerView: 2,
      spaceBetween: 20,
    },
    1024: {
      slidesPerView: 3,
      spaceBetween: 20,
    },
  },
  navigation: {
    prevEl: '#client-success-stories-prev',
    nextEl: '#client-success-stories-next',
  },
};
---

<!-- BEGIN: ClientTestimonialsSection -->
<section
  class='py-20 bg-background border-b border-border'
  data-purpose='client-testimonials'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6'>
    <!-- Section Title & Arrows -->
    <div class='flex items-end justify-between mb-12'>
      <div>
        <div class='flex items-center gap-2 mb-2'>
          <span class='w-5 h-1 bg-primary rounded-full'></span>
          <span class='text-xs uppercase tracking-wider font-extrabold text-muted-foreground'>
            CLIENT TESTIMONIALS
          </span>
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold text-foreground tracking-tight'>
          What Our Clients Say
        </h2>
      </div>
      <!-- Slider Arrow Controls -->
      <!-- <div class='flex items-center gap-2.5'>
        <button
          aria-label='Previous Testimonial'
          class='w-9 h-9 rounded-full border border-border hover:border-primary hover:text-brand-orange flex items-center justify-center text-slate-600 transition-colors'
          type='button'>
          <i class='fa-solid fa-chevron-left text-xs'></i>
        </button>
        <button
          aria-label='Next Testimonial'
          class='w-9 h-9 rounded-full border border-slate-300 hover:border-brand-orange hover:text-brand-orange flex items-center justify-center text-slate-600 transition-colors'
          type='button'>
          <i class='fa-solid fa-chevron-right text-xs'></i>
        </button>
      </div> -->

      <!-- Slider Pagination Prev / Next Buttons -->
      <div class='flex items-center gap-2'>
        <Button
          variant={'outline'}
          size={'icon-lg'}
          className='rounded-full'
          id='client-success-stories-prev'>
          <ChevronLeftIcon />
        </Button>
        <Button
          variant={'outline'}
          size={'icon-lg'}
          className='rounded-full'
          id='client-success-stories-next'>
          <ChevronRightIcon />
        </Button>
      </div>
    </div>
    <!-- Testimonial Cards 3-Grid -->
    <Swiper id='swiper-custom-navigation' options={opts}>
      <SwiperWrapper>
        {repeatedTestimonials.map((testimonial) => (
          <SwiperSlide class={'w-full h-full py-8'}>
            <Card className='w-full h-60'>
              <CardHeader className='space-y-3'>
                <CardTitle>
                  <div class='text-muted-foreground text-3xl font-serif leading-none'>
                    <QuoteIcon className='size-6 md:size-8 -rotate-180' />
                  </div>
                </CardTitle>
                <CardDescription>
                  <p>{testimonial.review}</p>
                </CardDescription>
              </CardHeader>
              <CardFooter className='mt-auto justify-start'>
                <div class='flex items-center gap-3.5'>
                  <div class='w-11 h-11 rounded-full overflow-hidden shrink-0'>
                    <img
                      alt={testimonial.name}
                      class='w-full h-full object-cover'
                      src={testimonial.image}
                    />
                  </div>
                  <div>
                    <div class='flex text-xs mb-1'>
                      {Array.from({ length: testimonial.rating }).map(() => (
                        <StarIcon className='fill-yellow-400 stroke-amber-50 size-3' />
                      ))}
                    </div>
                    <h4 class='text-sm font-bold text-foreground leading-tight'>
                      {testimonial.name}
                    </h4>
                    <p class='text-[11px] text-muted-foreground font-medium'>
                      {testimonial.designation}
                    </p>
                  </div>
                </div>
              </CardFooter>
            </Card>
          </SwiperSlide>
        ))}
      </SwiperWrapper>
    </Swiper>

    <!-- <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8'>
      {testimonies.map((testimonial) => (
        <Card>
          <CardHeader className='space-y-3'>
            <CardTitle>
              <div class='text-muted-foreground text-3xl font-serif leading-none'>
                <QuoteIcon className='size-6 md:size-8 -rotate-180' />
              </div>
            </CardTitle>
