---
import {
  ArrowRightCircleIcon,
  LayersIcon,
  TargetIcon,
  TrendingUpIcon,
  UserCog2Icon,
  WorkflowIcon,
} from 'lucide-react';
import { Button } from '../ui/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '../ui/card';

const services = [
  {
    title: 'Performance Marketing',
    description:
      'Get high-quality leads and measurable ROI with Meta & Google Ads.',
    icon: TargetIcon,
  },
  {
    title: 'Lead Generation Systems',
    description:
      'Build a predictable pipeline of qualified leads and appointments.',
    icon: UserCog2Icon,
  },
  {
    title: 'Social Media Management',
    description:
      'Grow your brand, engage your audience, and increase conversions.',
    icon: LayersIcon,
  },
  {
    title: 'Marketing Automation',
    description:
      'Save time and scale with CRM, automation, and funnel systems.',
    icon: WorkflowIcon,
  },
  {
    title: 'Growth Consulting',
    description:
      'Get a customized digital growth strategy for long-term success.',
    icon: TrendingUpIcon,
  },
];
---

<!-- BEGIN: OurServicesSection -->
<section
  class='py-20 bg-background border-b border-border'
  data-purpose='services-showcase'
  id='services'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Section Header -->
    <div class='flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-12 border-b border-border mb-12'>
      <div class='max-w-xl'>
        <div class='flex items-center gap-2 mb-2.5'>
          <span class='w-5 h-1 bg-primary rounded-full'></span>
          <span class='text-xs uppercase tracking-wider font-extrabold text-muted-foreground'>
            OUR SERVICES
          </span>
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold text-foreground tracking-tight'>
          End-to-End Digital Growth Solutions
        </h2>
      </div>
      <p class='text-sm sm:text-base text-muted-foreground max-w-md lg:border-l-2 lg:border-border lg:pl-6 leading-relaxed'>
        From strategy to execution, we provide integrated digital marketing
        solutions that drive leads, sales, and long-term business growth.
      </p>
    </div>
    <!-- Services 5-Column Grid -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5'>
      {services.map((service) => (
        <Card className='group border border-border hover:border-primary/50 transition-all duration-300 hover:shadow-lg'>
          <CardContent>
            <div class='w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5 group-hover:bg-primary group-hover:text-background transition-colors duration-300'>
              <service.icon className='w-5 h-5' />
            </div>
          </CardContent>
          <CardHeader>
            <CardTitle>
              <h3 class='text-lg font-bold text-muted-foreground mb-2 leading-snug'>
                {service.title}
              </h3>
            </CardTitle>
            <CardDescription>
              <p class='text-xs text-muted-foreground leading-relaxed'>
                {service.description}
              </p>
            </CardDescription>
          </CardHeader>
          <CardFooter className='mt-auto justify-end'>
            <Button variant={'outline'} size={'icon-lg'}>
              <ArrowRightCircleIcon className='w-4 h-4' />
            </Button>
          </CardFooter>
        </Card>
      ))}
    </div>
  </div>
</section>
<!-- END: OurServicesSection -->
