---
import type { SVG } from '@/types';
import Marquee from '@moonarc/core/Marquee';
import { Image } from 'astro:assets';

const response = await fetch('https://api.svgl.app', {
  method: 'GET',
  headers: {
    'Content-Type': 'application/json',
    'Cache-Control': 'max-age=864000, stale-while-revalidate=864000',
  },
  cache: 'force-cache',
});
const data = (await response.json()) as SVG[];

const logos = data
  .map((l) => {
    if (typeof l.route === 'string') {
      return l;
    }
    return null;
  })
  .splice(0, 10)
  .filter((l) => l !== null) as SVG[];
---

<!-- BEGIN: BrandsWorkedWithSection -->
<section
  class='py-12 bg-background border-b border-border'
  data-purpose='trusted-brands'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <div class='flex flex-col lg:flex-row items-center justify-between gap-8'>
      <!-- Heading Label -->
      <div class='text-center lg:text-left shrink-0'>
        <div class='flex items-center gap-2 justify-center lg:justify-start mb-1'>
          <span class='w-4 h-1 bg-primary rounded-full'></span>
          <span class='text-[10px] uppercase tracking-wider font-extrabold text-muted-foreground'>
            TRUSTED BY LEADING BRANDS
          </span>
        </div>
        <h3 class='text-lg sm:text-xl font-extrabold text-foreground tracking-tight'>
          Brands &amp; Companies
          <br class='hidden sm:inline' />
          We've Worked With
        </h3>
      </div>
      <!-- Corporate Partner Logos Row -->
      <Marquee duration={12} gap='3' class={'w-full'}>
        {logos.map((logo) => (
          <Image
            src={logo.route as string}
            alt={logo.id.toString()}
            class='h-8 w-auto object-contain'
            width={32}
            height={32}
          />
        ))}
      </Marquee>
    </div>
  </div>
</section>
<!-- END: BrandsWorkedWithSection -->
