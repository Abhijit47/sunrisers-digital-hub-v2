<!-- BEGIN: OurServicesSection -->
<section
  class='py-20 bg-background border-b border-border'
  data-purpose='services-showcase'
  id='services'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Section Header -->
    <div class='flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-12 border-b border-border mb-12'>
      <div class='max-w-xl'>
        <div class='flex items-center gap-2 mb-2.5'>
          <span class='w-5 h-1 bg-brand-orange rounded-full'></span>
          <span class='text-xs uppercase tracking-wider font-extrabold text-brand-orange'>
            OUR SERVICES
          </span>
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight'>
          End-to-End Digital Growth Solutions
        </h2>
      </div>
      <p class='text-sm sm:text-base text-slate-600 max-w-md lg:border-l-2 lg:border-slate-300 lg:pl-6 leading-relaxed'>
        From strategy to execution, we provide integrated digital marketing
        solutions that drive leads, sales, and long-term business growth.
      </p>
    </div>
    <!-- Services 5-Column Grid -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5'>
      <!-- Service Card 1 -->
      <div class='bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-brand-orange/40 transition-all duration-300 flex flex-col justify-between service-card-shadow group'>
        <div>
          <div class='w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300'>
            <i class='fa-solid fa-bullseye text-xl'></i>
          </div>
          <h3 class='text-lg font-bold text-slate-900 mb-2 leading-snug'>
            Performance Marketing
          </h3>
          <p class='text-xs text-slate-500 leading-relaxed'>
            Get high-quality leads and measurable ROI with Meta &amp; Google
            Ads.
          </p>
        </div>
        <div class='mt-6 pt-4 border-t border-slate-100 flex items-center text-blue-600 group-hover:text-brand-orange transition-colors'>
          <i class='fa-solid fa-arrow-right text-sm'></i>
        </div>
      </div>
      <!-- Service Card 2 -->
      <div class='bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-brand-orange/40 transition-all duration-300 flex flex-col justify-between service-card-shadow group'>
        <div>
          <div class='w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300'>
            <i class='fa-solid fa-users-gear text-xl'></i>
          </div>
          <h3 class='text-lg font-bold text-slate-900 mb-2 leading-snug'>
            Lead Generation Systems
          </h3>
          <p class='text-xs text-slate-500 leading-relaxed'>
            Build a predictable pipeline of qualified leads and appointments.
          </p>
        </div>
        <div class='mt-6 pt-4 border-t border-slate-100 flex items-center text-blue-600 group-hover:text-brand-orange transition-colors'>
          <i class='fa-solid fa-arrow-right text-sm'></i>
        </div>
      </div>
      <!-- Service Card 3 -->
      <div class='bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-brand-orange/40 transition-all duration-300 flex flex-col justify-between service-card-shadow group'>
        <div>
          <div class='w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300'>
            <i class='fa-solid fa-layer-group text-xl'></i>
          </div>
          <h3 class='text-lg font-bold text-slate-900 mb-2 leading-snug'>
            Social Media Management
          </h3>
          <p class='text-xs text-slate-500 leading-relaxed'>
            Grow your brand, engage your audience, and increase conversions.
          </p>
        </div>
        <div class='mt-6 pt-4 border-t border-slate-100 flex items-center text-blue-600 group-hover:text-brand-orange transition-colors'>
          <i class='fa-solid fa-arrow-right text-sm'></i>
        </div>
      </div>
      <!-- Service Card 4 -->
      <div class='bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-brand-orange/40 transition-all duration-300 flex flex-col justify-between service-card-shadow group'>
        <div>
          <div class='w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300'>
            <i class='fa-solid fa-gear text-xl'></i>
          </div>
          <h3 class='text-lg font-bold text-slate-900 mb-2 leading-snug'>
            Marketing Automation
          </h3>
          <p class='text-xs text-slate-500 leading-relaxed'>
            Save time and scale with CRM, automation, and funnel systems.
          </p>
        </div>
        <div class='mt-6 pt-4 border-t border-slate-100 flex items-center text-blue-600 group-hover:text-brand-orange transition-colors'>
          <i class='fa-solid fa-arrow-right text-sm'></i>
        </div>
      </div>
      <!-- Service Card 5 -->
      <div class='bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-brand-orange/40 transition-all duration-300 flex flex-col justify-between service-card-shadow group'>
        <div>
          <div class='w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300'>
            <i class='fa-solid fa-arrow-trend-up text-xl'></i>
          </div>
          <h3 class='text-lg font-bold text-slate-900 mb-2 leading-snug'>
            Growth Consulting
          </h3>
          <p class='text-xs text-slate-500 leading-relaxed'>
            Get a customized digital growth strategy for long-term success.
          </p>
        </div>
        <div class='mt-6 pt-4 border-t border-slate-100 flex items-center text-blue-600 group-hover:text-brand-orange transition-colors'>
          <i class='fa-solid fa-arrow-right text-sm'></i>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: OurServicesSection -->
