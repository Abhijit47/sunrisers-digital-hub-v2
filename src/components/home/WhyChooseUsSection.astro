---
import CountUpNumber from '@/components/CountUpNumber.astro';
import {
  CalendarCheckIcon,
  ChartNoAxesCombinedIcon,
  CircleDashedCheckIcon,
  StarCheckIcon,
  UsersRoundCollaborationIcon,
} from 'lucide-react';

import { Image } from 'astro:assets';

import WhyChooseUsImg from '../../../public/why-choose-us.png';

const metrics = [
  {
    icon: UsersRoundCollaborationIcon,
    value: 500,
    suffix: '+',
    label: 'Projects Delivered',
  },
  {
    icon: ChartNoAxesCombinedIcon,
    value: 100,
    suffix: '+',
    label: 'Businesses Grown',
  },
  {
    icon: CalendarCheckIcon,
    value: 8,
    suffix: '+',
    label: 'Years of Experience',
  },
  {
    icon: StarCheckIcon,
    value: 4.8,
    suffix: '/5',
    label: 'Client Satisfaction',
  },
];

const checklistItems = [
  'Strategy-First, Performance-Focused Approach',
  'Data-Driven Execution & Transparent Reporting',
  'Industry-Specific & Customized Solutions',
  'End-to-End Support from Strategy to Results',
];
---

<!-- BEGIN: WhyChooseUsSection -->
<section class='py-20 bg-background' data-purpose='why-choose-us'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-10 items-center'>
      <!-- Left Side: Strategic Team Image -->
      <div class='lg:col-span-5 rounded-3xl overflow-hidden shadow-xl border border-border relative group'>
        <Image
          src={WhyChooseUsImg}
          alt='Sunrisers Marketing Strategy Team Collaboration'
          class='w-full h-100 lg:h-110 object-cover group-hover:scale-105 transition-transform duration-500'
          inferSize
        />
      </div>
      <!-- Middle & Right Content -->
      <div class='lg:col-span-7 flex flex-col md:flex-row gap-8 lg:gap-10 justify-between items-start md:items-center'>
        <!-- Features List -->
        <div class='flex-1'>
          <div class='flex items-center gap-2 mb-2'>
            <span class='w-5 h-1 bg-primary rounded-full'></span>
            <span class='text-xs uppercase tracking-wider font-extrabold text-muted-foreground'>
              WHY CHOOSE US
            </span>
          </div>
          <h2 class='text-3xl sm:text-4xl font-extrabold text-foreground tracking-tight leading-tight mb-6'>
            Your Strategic Partner
            <br class='hidden sm:inline' />
            for Sustainable Growth
          </h2>
          <!-- Checklist items -->
          <ul class='space-y-4 text-sm font-semibold text-muted-foreground leading-snug'>
            {checklistItems.map((item) => (
              <li class='flex items-center gap-3'>
                <span class='w-6 h-6 rounded-full bg-primary text-background flex items-center justify-center shrink-0 text-xs'>
                  <CircleDashedCheckIcon />
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <!-- Vertical Metric Stack -->
        <div class='w-full md:w-auto md:border-l md:border-border md:pl-8 space-y-6 pt-4 md:pt-0'>
          {metrics.map((metric) => (
            <div class='flex items-center gap-3.5'>
              <div>
                <metric.icon className='w-5 h-5 text-muted-foreground' />
              </div>
              <div>
                <p>
                  <CountUpNumber
                    className='text-xl font-black text-foreground leading-none'
                    end={metric.value}
                    suffix={metric.suffix}
                    autoAnimate={true}
                    useIndianSeparators={true}
                  />
                </p>
                <p class='text-xs text-muted-foreground font-medium'>
                  {metric.label}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: WhyChooseUsSection -->
