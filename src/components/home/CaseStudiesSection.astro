---
import { cn } from '@/lib/utils';
import { ArrowRightCircleIcon } from 'lucide-react';
import { Button, buttonVariants } from '../ui/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '../ui/card';

const caseStudies = [
  {
    title: '50+ Leads in 20 Days',
    description:
      'Generated high-quality leads with just ₹5,000 ad spend (CPL ₹84).',
    imageUrl: '/case-1.png',
    link: '#',
  },
  {
    title: '900+ Leads in 9 Months',
    description: 'Built a consistent lead pipeline with Meta Ads & funnels.',
    imageUrl: '/case-2.png',
    link: '#',
  },
  {
    title: '3.2x ROAS',
    description:
      'Scaled revenue with performance marketing & creative testing.',
    imageUrl: '/case-3.png',
    link: '#',
  },
];
---

<!-- BEGIN: CaseStudiesSection -->
<section
  class='py-20 bg-foreground dark:bg-background text-primary'
  data-purpose='case-studies'
  id='work'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Header row -->
    <div class='flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12'>
      <div>
        <div class='flex items-center gap-2 mb-2'>
          <span class='w-5 h-1 bg-primary rounded-full'></span>
          <span class='text-xs uppercase tracking-wider font-extrabold text-muted-foreground'>
            CASE STUDIES
          </span>
        </div>
        <h2 class='text-3xl sm:text-4xl font-extrabold tracking-tight text-background dark:text-foreground'>
          Real Business Results
        </h2>
      </div>
      <a
        class={cn(
          buttonVariants({
            variant: 'outline',
            size: 'lg',
            class: 'rounded-full',
          }),
        )}
        href='#case-studies'>
        <span>View All Case Studies</span>
        <ArrowRightCircleIcon />
      </a>
    </div>
    <!-- 3 Case Study Cards Grid -->
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8'>
      {caseStudies.map((caseStudy) => (
        <Card className='group pt-0'>
          <CardContent className='p-0'>
            <div class='h-full w-full overflow-hidden relative aspect-video'>
              <img
                alt={caseStudy.title}
                class='w-full h-full object-cover group-hover:scale-105 transition-transform rounded-t-lg duration-500'
                src={caseStudy.imageUrl}
              />
            </div>
          </CardContent>
          <CardHeader>
            <CardTitle>
              <h3 class='text-xl font-black text-foreground mb-2'>
                {caseStudy.title}
              </h3>
            </CardTitle>
            <CardDescription>
              <p>{caseStudy.description}</p>
            </CardDescription>
          </CardHeader>
          <CardFooter className='mt-auto justify-end'>
            <Button className='rounded-full!' size={'icon-lg'}>
              <ArrowRightCircleIcon />
            </Button>
          </CardFooter>
        </Card>
      ))}
    </div>
  </div>
</section>
<!-- END: CaseStudiesSection -->
