---
import { cn } from '@/lib/utils';
import Link from 'astro-typesafe-routes/link';
import type { RouteId } from 'astro-typesafe-routes/path';
import { Image } from 'astro:assets';
import { ArrowRightCircleIcon } from 'lucide-react';
import Logo from '../../public/logo.png';
import MobileNav from './mobile-nav.tsx';
import { buttonVariants } from './ui/button';

const navlinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Services', href: '/services' },
  { name: 'Industries', href: '/industries' },
  { name: 'Case Studies', href: '/case-studies' },
  { name: 'Resources', href: '/resources' },
  { name: 'Contact', href: '/contact' },
];

const pathname = Astro.request.url.split('/')[3] || '/';
---

<!-- BEGIN: TopNavigation -->
<header class='sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-border transition-all duration-300'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between'>
    <!-- Brand Logo -->
    <Link class='flex items-center gap-2.5 group' to='/'>
      <Image
        src={Logo}
        alt='Sunrisers Digital Hub Logo'
        inferSize={true}
        class={'w-auto h-12'}
      />
    </Link>
    <!-- Desktop Nav Links -->
    <nav class='hidden lg:flex items-center space-x-7 text-sm font-semibold text-slate-700'>
      {navlinks.map((link) => {
        const isHomePage = link.href === '/';
        return (
          <Link
            to={link.href as RouteId}
            class={cn(
              'text-muted-foreground font-medium hover:text-primary transition-colors',
              {
                'text-primary border-primary border-b-2 pb-0.5 font-bold':
                  (pathname === '/' && isHomePage) ||
                  pathname === link.href.split('/')[1],
              },
            )}>
            {link.name}
          </Link>
        );
      })}
    </nav>
    <!-- Primary Action CTA Button -->
    <div class='flex items-center gap-4'>
      <a
        class={cn(
          buttonVariants({
            variant: 'default',
            size: 'lg',
            class: 'rounded-full',
          }),
          'hidden lg:flex',
        )}
        href='#consultation'>
        <span>Get a Free Consultation</span>
        <ArrowRightCircleIcon />
      </a>
      <MobileNav client:visible pathname={pathname} />
    </div>
  </div>
</header>
<!-- END: TopNavigation -->
