{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./*",
        "./src/*",
        "./src/components/*",
        "./src/types/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "types/*": [
        "./src/types/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ]
    },
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}