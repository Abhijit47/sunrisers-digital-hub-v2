---
---

<!-- BEGIN: ClientTestimonialsSection -->
<section class='py-16 bg-[#f8fafc]' data-purpose='client-testimonials'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- Testimonials Header & Carousel Controls -->
    <div class='flex items-end justify-between mb-10'>
      <div>
        <div class='inline-flex items-center gap-2 text-brand-orange font-bold text-xs tracking-widest uppercase'>
          <span class='w-5 h-0.5 bg-brand-orange inline-block'></span>
          CLIENT TESTIMONIALS
        </div>
        <h2 class='text-3xl font-extrabold text-[#08234d] tracking-tight mt-1'>
          What Our Clients Say
        </h2>
      </div>
      <!-- Next / Prev Arrows -->
      <div class='flex items-center gap-2'>
        <button
          aria-label='Previous Testimonial'
          class='w-9 h-9 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition-colors shadow-sm'>
          <i class='fa-solid fa-chevron-left text-xs'></i>
        </button>
        <button
          aria-label='Next Testimonial'
          class='w-9 h-9 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition-colors shadow-sm'>
          <i class='fa-solid fa-chevron-right text-xs'></i>
        </button>
      </div>
    </div>
    <!-- 3 Testimonial Cards -->
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
      <!-- Testimonial 1 -->
      <div class='bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between'>
        <div class='space-y-3'>
          <div class='text-brand-orange text-2xl font-serif'>
            <i class='fa-solid fa-quote-left'></i>
          </div>
          <p class='text-slate-700 text-xs sm:text-sm leading-relaxed'>
            Sunrisers Digital Hub helped us generate 3X more leads with their
            result-driven strategies.
          </p>
        </div>
        <div class='flex items-center gap-3 pt-6 mt-6 border-t border-slate-100'>
          <div class='w-9 h-9 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600 shrink-0'>
            <i class='fa-solid fa-building text-sm'></i>
          </div>
          <div>
            <h5 class='text-xs font-bold text-[#08234d]'>Rahul Sharma</h5>
            <p class='text-[11px] text-slate-500'>Real Estate Developer</p>
          </div>
        </div>
      </div>
      <!-- Testimonial 2 -->
      <div class='bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between'>
        <div class='space-y-3'>
          <div class='text-brand-orange text-2xl font-serif'>
            <i class='fa-solid fa-quote-left'></i>
          </div>
          <p class='text-slate-700 text-xs sm:text-sm leading-relaxed'>
            Their expertise in digital marketing is outstanding. Highly
            recommended!
          </p>
        </div>
        <div class='flex items-center gap-3 pt-6 mt-6 border-t border-slate-100'>
          <div class='w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0'>
            <i class='fa-solid fa-leaf text-sm'></i>
          </div>
          <div>
            <h5 class='text-xs font-bold text-[#08234d]'>Priya Nair</h5>
            <p class='text-[11px] text-slate-500'>Wellness Coach</p>
          </div>
        </div>
      </div>
      <!-- Testimonial 3 -->
      <div class='bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between'>
        <div class='space-y-3'>
          <div class='text-brand-orange text-2xl font-serif'>
            <i class='fa-solid fa-quote-left'></i>
          </div>
          <p class='text-slate-700 text-xs sm:text-sm leading-relaxed'>
            A professional and reliable partner for all our digital needs.
          </p>
        </div>
        <div class='flex items-center gap-3 pt-6 mt-6 border-t border-slate-100'>
          <div class='w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600 shrink-0'>
            <i class='fa-solid fa-bag-shopping text-sm'></i>
          </div>
          <div>
            <h5 class='text-xs font-bold text-[#08234d]'>Amit Verma</h5>
            <p class='text-[11px] text-slate-500'>D2C Brand Founder</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: ClientTestimonialsSection -->
