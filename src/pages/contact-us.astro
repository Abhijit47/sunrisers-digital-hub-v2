---
import { createRoute } from 'astro-typesafe-routes/create-route';
import Layout from '../layouts/Layout.astro';
import { bumpTransition } from '../lib/view-transitions';

export const Route = createRoute({
  routeId: '/contact-us',
});

const pathname = Astro.request.url.split('/')[3] || '/';
---

<Layout title='About'>
  <main transition:animate={bumpTransition}>
    <h1 class='text-2xl text-center font-bold mt-10'>{pathname} Route</h1>
  </main>
</Layout>
